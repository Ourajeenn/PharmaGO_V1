n>\r\n                <Button type=\"submit\">\r\n                    <Upload className=\"h-4 w-4 mr-2\" />\r\n                    T├®l├®verser\r\n                </Button>\r\n            </div>\r\n        </form>\r\n    </DialogContent>\r\n                        </Dialog >\r\n                    </div >\r\n\r\n    {/* Stats */ }\r\n    < div className = \"grid grid-cols-1 md:grid-cols-4 gap-4 mb-8\" >\r\n        <Card>\r\n            <CardContent className=\"p-6\">\r\n                <div className=\"text-center\">\r\n                    <p className=\"text-sm text-muted-foreground mb-1\">Total</p>\r\n                    <p className=\"text-3xl font-bold\">{documents.length}</p>\r\n                </div>\r\n            </CardContent>\r\n        </Card>\r\n{\r\n    ['Ordonnance', 'Radio', 'Analyse'].map(type => (\r\n        <Card key={type}>\r\n            <CardContent className=\"p-6\">\r\n                <div className=\"text-center\">\r\n                    <p className=\"text-sm text-muted-foreground mb-1\">{type}s</p>\r\n                    <p className=\"text-3xl font-bold\">\r\n                        {documents.filter(d => d.documentType === type).length}\r\n                    </p>\r\n                </div>\r\n            </CardContent>\r\n        </Card>\r\n    ))\r\n}\r\n                    </div >\r\n\r\n    {/* Documents Grid */ }\r\n    < Card >\r\n                        <CardHeader>\r\n                            <CardTitle>Tous les documents</CardTitle>\r\n                        </CardHeader>\r\n                        <CardContent>\r\n                            {documents.length === 0 ? (\r\n                                <div className=\"text-center py-12\">\r\n                                    <FileText className=\"h-16 w-16 mx-auto mb-4 text-muted-foreground\" />\r\n                                    <h3 className=\"text-xl font-semibold mb-2\">Aucun document</h3>\r\n                                    <p className=\"text-muted-foreground mb-4\">\r\n                                        Commencez ├á t├®l├®verser vos documents m├®dicaux\r\n                                    </p>\r\n                                    <Button onClick={() => setIsDialogOpen(true)}>\r\n                                        <Plus className=\"h-4 w-4 mr-2\" />\r\n                                        Ajouter le premier document\r\n                                    </Button>\r\n                                </div>\r\n                            ) : (\r\n                                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\r\n                                    {documents.map((doc) => (\r\n                                        <Card key={doc.id} className=\"hover:shadow-lg transition-shadow\">\r\n                                            <CardContent className=\"p-4\">\r\n                                                <div className=\"flex items-start gap-3 mb-3\">\r\n                                                    {getFileIcon(doc.fileType)}\r\n                                                    <div className=\"flex-1 min-w-0\">\r\n                                                        <h4 className=\"font-semibold truncate\">{doc.title}</h4>\r\n                                                        <p className=\"text-xs text-muted-foreground\">\r\n                                                            {format(new Date(doc.uploadDate), 'dd MMM yyyy', { locale: fr })}\r\n                                                        </p>\r\n                                                    </div>\r\n                                                </div>\r\n\r\n                                                <Badge variant=\"outline\" className=\"mb-3\">\r\n                                                    {doc.documentType}\r\n                                                </Badge>\r\n\r\n                                                {doc.description && (\r\n                                                    <p className=\"text-sm text-muted-foreground mb-3 line-clamp-2\">\r\n                                                        {doc.description}\r\n                                                    </p>\r\n                                                )}\r\n\r\n                                                <div className=\"text-xs text-muted-foreground mb-3\">\r\n                                                    {formatFileSize(doc.fileSize)}\r\n                                                </div>\r\n\r\n                                                <div className=\"flex gap-2\">\r\n                                                    <Button\r\n                                                        size=\"sm\"\r\n                                                        variant=\"outline\"\r\n                                                        className=\"flex-1\"\r\n                                                        onClick={() => handleDownload(doc)}\r\n                                                    >\r\n                                                        <Download className=\"h-4 w-4 mr-1\" />\r\n                                                        T├®l├®charger\r\n                                                    </Button>\r\n                                                    <Button\r\n                                                        size=\"sm\"\r\n                                                        variant=\"ghost\"\r\n                                                        onClick={() => handleDelete(doc.id)}\r\n                                                    >\r\n                                                        <Trash2 className=\"h-4 w-4 text-destructive\" />\r\n                                                    </Button>\r\n                                                </div>\r\n                                            </CardContent>\r\n          