rmData(prev => ({ ...prev, allergen: e.target.value }))}\r\n                        placeholder=\"Ex: Arachides, P├®nicilline...\"\r\n                        required\r\n                    />\r\n                </div>\r\n            </div>\r\n\r\n            <div className=\"grid grid-cols-2 gap-4\">\r\n                <div>\r\n                    <Label htmlFor=\"severity\">S├®v├®rit├® *</Label>\r\n                    <Select\r\n                        value={formData.severity}\r\n                        onValueChange={(value: AllergySeverity) =>\r\n                            setFormData(prev => ({ ...prev, severity: value }))\r\n                        }\r\n                    >\r\n                        <SelectTrigger>\r\n                            <SelectValue />\r\n                        </SelectTrigger>\r\n                        <SelectContent>\r\n                            <SelectItem value=\"L├®g├¿re\">L├®g├¿re</SelectItem>\r\n                            <SelectItem value=\"Mod├®r├®e\">Mod├®r├®e</SelectItem>\r\n                            <SelectItem value=\"S├®v├¿re\">S├®v├¿re</SelectItem>\r\n                            <SelectItem value=\"Critique\">Critique</SelectItem>\r\n                        </SelectContent>\r\n                    </Select>\r\n                </div>\r\n\r\n                <div>\r\n                    <Label htmlFor=\"diagnosedDate\">Date de diagnostic</Label>\r\n                    <Input\r\n                        id=\"diagnosedDate\"\r\n                        type=\"date\"\r\n                        value={formData.diagnosedDate}\r\n                        onChange={(e) => setFormData(prev => ({ ...prev, diagnosedDate: e.target.value }))}\r\n                    />\r\n                </div>\r\n            </div>\r\n\r\n            <div>\r\n                <Label htmlFor=\"symptoms\">Sympt├┤mes (s├®par├®s par des virgules)</Label>\r\n                <Input\r\n                    id=\"symptoms\"\r\n                    value={formData.symptoms}\r\n                    onChange={(e) => setFormData(prev => ({ ...prev, symptoms: e.target.value }))}\r\n                    placeholder=\"Ex: ├ëruption cutan├®e, D├®mangeaisons, Gonflement\"\r\n                />\r\n            </div>\r\n\r\n            <div>\r\n                <Label htmlFor=\"medication\">M├®dicament d'urgence</Label>\r\n                <Input\r\n                    id=\"medication\"\r\n                    value={formData.medication}\r\n                    onChange={(e) => setFormData(prev => ({ ...prev, medication: e.target.value }))}\r\n                    placeholder=\"Ex: EpiPen, Antihistaminique\"\r\n                />\r\n            </div>\r\n\r\n            <div>\r\n                <Label htmlFor=\"emergencyProtocol\">Protocole d'urgence</Label>\r\n                <Textarea\r\n                    id=\"emergencyProtocol\"\r\n                    value={formData.emergencyProtocol}\r\n                    onChange={(e) => setFormData(prev => ({ ...prev, emergencyProtocol: e.target.value }))}\r\n                    rows={4}\r\n                    placeholder=\"D├®crivez les mesures ├á prendre en cas de r├®action...\"\r\n                />\r\n            </div>\r\n\r\n            <div className=\"flex justify-end gap-2\">\r\n                <Button type=\"button\" variant=\"outline\" onClick={() => setIsDialogOpen(false)}>\r\n                    Annuler\r\n                </Button>\r\n                <Button type=\"submit\">Enregistrer</Button>\r\n            </div>\r\n        </form>\r\n    </DialogContent>\r\n                        </Dialog >\r\n                    </div >\r\n\r\n    {/* Stats */ }\r\n    < div className = \"grid grid-cols-1 md:grid-cols-4 gap-4 mb-8\" >\r\n                        <Card>\r\n                            <CardContent className=\"p-6\">\r\n                                <div className=\"text-center\">\r\n                                    <p className=\"text-sm text-muted-foreground mb-1\">Total</p>\r\n                                    <p className=\"text-3xl font-bold\">{allergies.length}</p>\r\n                                </div>\r\n                            </CardContent>\r\n                        </Card>\r\n\r\n                        <Card>\r\n                            <CardContent className=\"p-6\">\r\n                                <div className=\"text-center\">\r\n                                    <p className=\"text-sm text-muted-foreground mb-1\">Critiques</p>\r\n                                    <p className=\"text-3xl font-bold text-red-600\">\r\n                                        {allergies.filter(a => a.severity === 'Critique').length}\r\n                                    </p>\r\n                                </div>\r\n                            </CardContent>\r\n                        </Card>\r\n\r\n                        <Card>\r\n                            <CardContent className=\"p-6\">\r\n                                <div className=\"text-center\">\r\n                                    <p className=\"text-sm text-muted-foreground mb-1\">S├®v├¿res</p>\r\n                                    <p className=\"text-3xl font-bold text-orange-600\">\r\n                                        {allergies.filter(a => a.severity === 'S├®v├¿re').length}\r\n                                    </p>\r\n                                </div>\r\n                            </CardContent>\r\n                        </Card>\r\n\r\n                        <Card>\r\n                            <CardContent className=\"p-6\">\r\n                                <div className=\"text-center\">\r\n                                    <p className=\"text-sm text-muted-foreground mb-1\">Alimentaires</p>\r\n                                    <p className=\"text-3xl font-bold text-blue-600\">\r\n                                        {allergies.filter(a => a.allergyType === 'Alimentaire').length}\r\n                                    </p>\r\n                                </div>\r\n                            </CardContent>\r\n                        </Card>\r\n                    </div >\r\n\r\n    {/* Allergies List */ }\r\n    < Card >\r\n                        <CardHeader>\r\n                            <CardTitle>Liste des allergies</CardTitle>\r\n                        </CardHeader>\r\n                        <CardContent>\r\n                            {allergies.length === 0 ? (\r\n                                <div className=\"text-center py-12\">\r\n                                    <AlertCircle className=\"h-16 w-16 mx-auto mb-4 text-muted-foreground\" />\r\n                                    <h3 className=\"text-xl font-semibold mb-2\">Aucune allergie enregistr├®e</h3>\r\n                                    <p className=\"text-muted-foreground mb-4\">\r\n                                        Commencez ├á enregistrer les allergies du patient\r\n                                    </p>\r\n                                    <Button onClick={() => setIsDialogOpen(true)}>\r\n                                        <Plus className=\"h-4 w-4 mr-2\" />\r\n                                        Ajouter la premi├¿re allergie\r\n                                    </Button>\r\n                                </div>\r\n                            ) : (\r\n                                <div className=\"space-y-4\">\r\n                                    {allergies.map((allergy) => (\r\n                                        <div\r\n                                            key={allergy.id}\r\n                                            className=\"border rounded-lg p-6 hover:bg-muted/50 transition-colors\"\r\n                                        >\r\n                                            <div className=\"flex items-start justify-between mb-4\">\r\n                                                <div className=\"flex items-center gap-4\">\r\n                            