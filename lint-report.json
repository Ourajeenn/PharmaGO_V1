({ onSuccess }: DriverAuthFormProps) => {\n  const [isSignUp, setIsSignUp] = useState(false)\n  const [showPassword, setShowPassword] = useState(false)\n  const [loading, setLoading] = useState(false)\n  const { signIn, signUp } = useAuth()\n  const { toast } = useToast()\n\n  const signInForm = useForm<z.infer<typeof signInSchema>>({\n    resolver: zodResolver(signInSchema),\n    defaultValues: {\n      email: '',\n      password: ''\n    }\n  })\n\n  const signUpForm = useForm<z.infer<typeof signUpSchema>>({\n    resolver: zodResolver(signUpSchema),\n    defaultValues: {\n      name: '',\n      email: '',\n      password: '',\n      confirmPassword: '',\n      phone: '',\n      cniNumber: '',\n      driverLicense: '',\n      vehicleType: '',\n      experience: ''\n    }\n  })\n\n  const onSignIn = async (values: z.infer<typeof signInSchema>) => {\n    setLoading(true)\n    try {\n      const { error } = await signIn(values.email, values.password)\n      if (error) throw error\n      \n      toast({\n        title: 'Connexion r├®ussie',\n        description: 'Bienvenue dans votre espace livreur!'\n      })\n      onSuccess?.()\n    } catch (error: any) {\n      toast({\n        title: 'Erreur de connexion',\n        description: error.message,\n        variant: 'destructive'\n      })\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  const onSignUp = async (values: z.infer<typeof signUpSchema>) => {\n    setLoading(true)\n    try {\n      const userData = {\n        name: values.name.trim(),\n        role: 'driver',\n        phone: values.phone.trim(),\n        vehicle_type: values.vehicleType.trim(),\n        license_plate: values.driverLicense.trim(),\n        experience_years: values.experience ? parseInt(values.experience) : undefined\n      }\n\n      const { error } = await signUp(values.email.trim(), values.password, userData)\n      \n      if (error) {\n        console.error('Driver signup error:', error)\n        \n        if (error.message.includes('already registered')) {\n          throw new Error('Cet email est d├®j├á utilis├®. Veuillez vous connecter.')\n        }\n        \n        throw new Error(error.message || 'Erreur lors de la cr├®ation du compte')\n      }\n      \n      toast({\n        title: 'Ô£à Candidature envoy├®e',\n        description: 'Votre dossier sera examin├® sous 24h.'\n      })\n      \n      signUpForm.reset()\n      setIsSignUp(false)\n    } catch (error: any) {\n      console.error('Driver registration error:', error)\n      toast({\n        title: 'ÔØî Erreur d\\'inscription',\n        description: error.message || 'Une erreur est survenue',\n        variant: 'destructive'\n      })\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-orange-50 via-background to-red-50 flex items-center justify-center p-4\">\n      <div className=\"w-full max-w-6xl\">\n        <Button \n          variant=\"outline\" \n          onClick={() => window.history.back()} \n          className=\"mb-4\"\n        >\n          ÔåÉ Retour\n        </Button>\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8 items-center\">\n        {/* Section informative */}\n        <div className=\"space-y-6\">\n          <div className=\"text-center lg:text-left\">\n            <h1 className=\"text-4xl font-bold text-primary mb-4\">\n              Espace Livreur\n            </h1>\n            <p className=\"text-xl text-muted-foreground mb-6\">\n              Devenez partenaire livreur et gagnez votre libert├®\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"bg-white p-4 rounded-lg shadow-sm border text-center\">\n              <Bike className=\"h-8 w-8 text-orange-500 mx-auto mb-2\" />\n              <h3 className=\"font-semibold text-sm\">Livraisons</h3>\n              <p className=\"text-xs text-muted-foreground\">Courses pharmacie</p>\n    