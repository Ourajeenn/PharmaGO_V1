dary/10 text-secondary border-secondary/20' \n                          : 'bg-destructive/10 text-destructive border-destructive/20'\n                      }`}\n                    >\n                      {pharmacy.isOpen ? \"­ƒƒó Ouverte\" : \"­ƒö┤ Ferm├®e\"}\n                    </Badge>\n                  </div>\n                  <div className=\"flex items-center gap-1\">\n                    <Star className=\"h-4 w-4 fill-yellow-400 text-yellow-400\" />\n                    <span className=\"text-sm font-medium\">{pharmacy.rating}</span>\n                  </div>\n                </div>\n              </CardHeader>\n\n              <CardContent className=\"space-y-4\">\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-start gap-2 text-sm\">\n                    <MapPin className=\"h-4 w-4 text-primary mt-0.5 flex-shrink-0\" />\n                    <div>\n                      <div>{pharmacy.address}</div>\n                      <div className=\"text-muted-foreground\">{pharmacy.commune} ÔÇó {pharmacy.distance}</div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 text-sm\">\n                    <Phone className=\"h-4 w-4 text-secondary\" />\n                    <span>{pharmacy.phone}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 text-sm\">\n                    <Clock className=\"h-4 w-4 text-accent\" />\n                    <span className=\"font-medium\">{pharmacy.hours}</span>\n                  </div>\n                </div>\n\n                <div>\n                  <h4 className=\"text-sm font-semibold mb-2\">Sp├®cialit├®s</h4>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {pharmacy.specialties.map(specialty => (\n                      <Badge key={specialty} variant=\"outline\" className=\"text-xs\">\n                        {specialty}\n                      </Badge>\n                    ))}\n                  </div>\n                </div>\n\n                <div>\n                  <h4 className=\"text-sm font-semibold mb-2\">Services</h4>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {pharmacy.services.map(service => (\n                      <Badge key={service} className=\"bg-primary/10 text-primary border-primary/20 text-xs\">\n                        {service}\n                      </Badge>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"flex gap-2 pt-2\">\n                  <Button \n                    size=\"sm\" \n                    className=\"flex-1\" \n                    disabled={!pharmacy.isOpen}\n                    onClick={() => handleCall(pharmacy.phone)}\n                  >\n                    <Phone className=\"h-4 w-4 mr-2\" />\n                    Appeler\n                  </Button>\n                  <Button \n                    variant=\"outline\" \n                    size=\"sm\" \n                    className=\"flex-1\"\n                    onClick={() => handleGetDirections(pharmacy.address)}\n                  >\n                    <Navigation className=\"h-4 w-4 mr-2\" />\n                    Itin├®raire\n                  </Button>\n                </div>\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n\n        {filteredPharmacies.length === 0 && (\n          <div className=\"text-center py-12\">\n            <div className=\"text-6xl mb-4\">­ƒÅÑ</div>\n            <h3 className=\"text-xl font-semibold mb-2\">Aucune pharmacie de garde trouv├®e</h3>\n            <p className=\"text-muted-foreground\">Essayez de modifier vos crit├¿res de recherche</p>\n          </div>\n        )}\n\n        {/* Emergency Notice */}\n        <div className=\"mt-12 bg-accent/10 border border-accent/20 rounded-lg p-6\">\n          <div className=\"flex items-start gap-3\