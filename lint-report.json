            fontWeight: '500',\n                cursor: 'pointer',\n                marginTop: '8px'\n              }}\n            >\n              Se connecter\n            </button>\n\n            <p style={{ textAlign: 'center', fontSize: '14px', marginTop: '8px' }}>\n              <span style={{ color: '#6B7280' }}>Pas de compte ? </span>\n              <button\n                type=\"button\"\n                onClick={() => setIsSignUp(true)}\n                style={{\n                  background: 'none',\n                  border: 'none',\n                  color: '#1E40AF',\n                  cursor: 'pointer',\n                  textDecoration: 'underline',\n                  fontSize: '14px'\n                }}\n              >\n                S'inscrire\n              </button>\n            </p>\n          </form>\n        )}\n      </div>\n    </div>\n  )\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\auth\\PharmacyAuth.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\types\\ecarnet.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\vite-env.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\supabase\\functions\\chat\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a 