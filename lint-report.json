]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\components\\PaymentSystem.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":110,"column":68,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":110,"endColumn":71,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3235,3238],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3235,3238],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":281,"column":80,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":281,"endColumn":83,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9728,9731],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9728,9731],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { RadioGroup, RadioGroupItem } from \"@/components/ui/radio-group\";\nimport { Label } from \"@/components/ui/label\";\nimport { Checkbox } from \"@/components/ui/checkbox\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { useCart } from \"@/contexts/CartContext\";\nimport { \n  ArrowLeft,\n  CreditCard,\n  Smartphone,\n  MapPin,\n  ShoppingCart,\n  CheckCircle,\n  AlertCircle,\n  Shield,\n  Clock,\n  Truck,\n  Receipt,\n  Wallet,\n  Zap,\n  Info\n} from \"lucide-react\";\nimport { toast } from \"sonner\";\n\ninterface PaymentMethod {\n  id: string;\n  name: string;\n  icon: string;\n  description: string;\n  processingTime: string;\n  available: boolean;\n}\n\nconst paymentMethods: PaymentMethod[] = [\n  {\n    id: 'orange_money',\n    name: 'Orange Money',\n    icon: '­ƒƒá',\n    description: 'Paiement rapide et s├®curis├® avec Orange Money',\n    processingTime: 'Instantan├®',\n    available: true\n  },\n  {\n    id: 'wave',\n    name: 'Wave',\n    icon: '­ƒÆÖ',\n    description: 'Envoi et r├®ception d\\'argent avec Wave',\n    processingTime: 'Instantan├®',\n    available: true\n  },\n  {\n    id: 'mtn_money',\n    name: 'MTN Mobile Money',\n    icon: '­ƒƒí',\n    description: 'Paiement mobile avec MTN Money',\n    processingTime: 'Instantan├®',\n    available: true\n  },\n  {\n    id: 'moov_money',\n    name: 'Moov Money',\n    icon: '­ƒöÁ',\n    description: 'Solution de paiement Moov Money',\n    processingTime: 'Instantan├®',\n    available: true\n  },\n  {\n    id: 'cash_on_delivery',\n    name: 'Paiement ├á la livraison',\n    icon: '­ƒÆ░',\n    description: 'Payez en esp├¿ces lors de la livraison',\n    processingTime: '├Ç la livraison',\n    available: true\n  },\n  {\n    id: 'card',\n    name: 'Carte bancaire',\n    icon: '­ƒÆ│',\n    description: 'Visa, Mastercard accept├®es',\n    processingTime: '1-2 minutes',\n    available: false\n  }\n];\n\ninterface PaymentSystemProps {\n  onBackToHome?: () => void;\n}\n\nconst PaymentSystem = ({ onBackToHome }: PaymentSystemProps) => {\n  const { items, getTotalPrice, groupByPharmacy, clearCart } = useCart();\n  const [selectedPaymentMethod, setSelectedPaymentMethod] = useState('orange_money');\n  const [phoneNumber, setPhoneNumber] = useState('');\n  const [deliveryAddress, setDeliveryAddress] = useState('');\n  const [useCurrentLocation, setUseCurrentLocation] = useState(false);\n  const [orderNotes, setOrderNotes] = useState('');\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [paymentStep, setPaymentStep] = useState<'details' | 'payment' | 'confirmation'>('details');\n  const [orderId, setOrderId] = useState<string>('');\n\n  const pharmacyGroups = groupByPharmacy();\n  const totalAmount = getTotalPrice();\n  \n  // Import delivery fee calculator\n  const [deliveryUrgency, setDeliveryUrgency] = useState<'standard' | 'express' | 'urgent'>('standard');\n  const [deliveryFeeBreakdown, setDeliveryFeeBreakdown] = useState<any>(null);\n  \n  // Calculate delivery fee with breakdown\n  useEffect(() => {\n    const calculateFee = async () => {\n      const { calculateDeliveryFee } = await import('@/lib/deliveryFeeCalculator');\n      const breakdown = calculateDeliveryFee({\n        pharmacyCount: Object.keys(pharmacyGroups).length,\n        urgency: deliveryUrgency,\n        timeOfDay: new Date(),\n        distance: 5, // Default distance\n      });\n      setDeliveryFeeBreakdown(breakdown);\n    };\n    calculateFee();\n  }, [pharmacyGroups, deliveryUrgency]);\n  \n  const deliveryFee = deliveryFeeBreakdown?.total || Object.keys(pharmacyGroups).length * 500;\n  const finalTotal = totalAmount + deliveryFee;\n\n  useEffect(() => {\n    if (useCurrentLocation && navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (position) => {\n          setDeliveryAddress(`Votre position actuelle (${position.coords.latitude.toFixed(4)}, ${position.coords.longitude.toFixed(4)})`);\n        },\n        () => {\n          setUseCurrentLocation(false);\n        }\n      );\n    }\n  }, [useCurrentLocation]);\n\n  const handlePayment = async () => {\n    if (!deliveryAddress || (selectedPaymentMethod !== 'cash_on_delivery' && !phoneNumber)) {\n      return;\n    }\n\n    setIsProcessing(true);\n    setPaymentStep('payment');\n\n    // Simuler le processus de paiement\n    setTimeout(() => {\n      const newOrderId = `ORD-${Date.now()}`;\n      setOrderId(newOrderId);\n      setPaymentStep('confirmation');\n      setIsProcessing(false);\n      \n      // Vider le panier apr├¿s paiement r├®ussi\n      if (selectedPaymentMethod !== 'cash_on_delivery') {\n        clearCart();\n      }\n    }, 3000);\n  };\n\n  const getPaymentMethodById = (id: string) => {\n    return paymentMethods.find(method => method.id === id);\n  };\n\n  if (items.length === 0 && paymentStep === 'details') {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <div className=\"bg-gradient-to-r from-primary to-secondary text-white\">\n          <div className=\"container mx-auto px-4 py-6\">\n            <div className=\"flex items-center gap-4\">\n              {onBackToHome && (\n                <Button\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  onClick={onBackToHome}\n                  className=\"text-white hover:bg-white/10\"\n                >\n                  <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                  Retour\n                </Button>\n              )}\n              <h1 className=\"text-3xl font-bold\">Paiement</h1>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"container mx-auto px-4 py-8\">\n          <Card>\n            <CardContent className=\"py-12 text-center\">\n              <ShoppingCart className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground\" />\n              <h3 className=\"text-xl font-semibold mb-2\">Votre panier est vide</h3>\n              <p className=\"text-muted-foreground mb-4\">\n                Ajoutez des m├®dicaments ├á votre panier pour proc├®der au paiement\n              </p>\n              <Button onClick={onBackToHome}>\n                Retour aux produits\n              </Button>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      {/* Header */}\n      <div className=\"bg-gradient-to-r from-primary to-secondary text-white\">\n        <div className=\"container mx-auto px-4 py-6\">\n          <div className=\"flex items-center gap-4\">\n            {onBackToHome && paymentStep === 'details' && (\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n                onClick={onBackToHome}\n                className=\"text-white hover:bg-white/10\"\n              >\n                <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                Retour\n              </Button>\n            )}\n            <h1 className=\"text-3xl font-bold\">\n              {paymentStep === 'details' && 'Paiement'}\n              {paymentStep === 'payment' && 'Traitement du paiement'}\n              {paymentStep === 'confirmation' && 'Confirmation'}\n            </h1>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"container mx-auto px-4 py-8\">\n        {paymentStep === 'details' && (\n          <div className=\"grid lg:grid-cols-3 gap-8\">\n            {/* Left Column - Order Details */}\n            <div className=\"lg:col-span-2 space-y-6\">\n              <Tabs defaultValue=\"delivery\" className=\"space-y-6\">\n                <TabsList className=\"grid w-full grid-cols-2\">\n                  <TabsTrigger value=\"delivery\">Livraison</TabsTrigger>\n                  <TabsTrigger value=\"payment\">Paiement</TabsTrigger>\n                </TabsList>\n\n                <TabsContent value=\"delivery\" className=\"space-y-6\">\n                  <Card>\n                    <CardHeader>\n                      <CardTitle className=\"flex items-center gap-2\">\n                        <MapPin className=\"h-5 w-5\" />\n                        Adresse de livraison\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent className=\"space-y-4\">\n                      <div className=\"flex items-center space-x-2\">\n                        <Checkbox \n                          id=\"current-location\" \n                          checked={useCurrentLocation}\n                          onCheckedChange={(checked) => setUseCurrentLocation(checked as boolean)}\n                        />\n                        <Label htmlFor=\"current-location\">Utiliser ma position actuelle</Label>\n                      </div>\n\n                      <div>\n                        <Label htmlFor=\"address\">Adresse compl├¿te</Label>\n                        <Input\n                          id=\"address\"\n                          placeholder=\"Entrez votre adresse de livraison\"\n                          value={deliveryAddress}\n                          onChange={(e) => setDeliveryAddress(e.target.value)}\n                          disabled={useCurrentLocation}\n                        />\n                      </div>\n                      \n                      {/* Urgency Selection */}\n                      <div className=\"space-y-3\">\n                        <Label className=\"text-sm font-medium flex items-center gap-2\">\n                          <Zap className=\"h-4 w-4\" />\n                          Urgence de livraison\n                        </Label>\n                        <Select value={deliveryUrgency} onValueChange={(value: any) => setDeliveryUrgency(value)}>\n                          <SelectTrigger>\n                            <SelectValue />\n                          </SelectTrigger>\n                          <SelectContent>\n                            <SelectItem value=\"standard\">\n                              <div className=\"flex items-center gap-2\">\n                                <Clock className=\"h-4 w-4\" />\n                                <div>\n                                  <p className=\"font-medium\">Standard (30-45 min)</p>\n                                  <p className=\"text-xs text-muted-foreground\">Livraison normale</p>\n                                </div>\n                              </div>\n                            </SelectItem>\n                            <SelectItem value=\"express\">\n                              <div className=\"flex items-center gap-2\">\n                                <Zap className=\"h-4 w-4\" />\n                                <div>\n                                  <p className=\"font-medium\">Express (15-25 min) +1000 FCFA</p>\n                                  <p className=\"text-xs text-muted-foreground\">Livraison rapide</p>\n                                </div>\n                              </div>\n                            </SelectItem>\n                            <SelectItem value=\"urgent\">\n                              <div className=\"flex items-center gap-2\">\n                                <AlertCircle className=\"h-4 w-4\" />\n                                <div>\n                                  <p className=\"font-medium\">Urgent (10-15 min) +2000 FCFA</p>\n                                  <p className=\"text-xs text-muted-foreground\">Livraison imm├®diate</p>\n                                </div>\n                              </div>\n                            </SelectItem>\n                          </SelectContent>\n                        </Select>\n                      </div>\n\n                      {/* Delivery Fee Breakdown */}\n                      {deliveryFeeBreakdown && (\n                        <Card className=\"bg-muted/50\">\n                          <CardContent className=\"pt-4 space-y-2\">\n                            <div className=\"flex items-center gap-2 mb-2\">\n                              <Info className=\"h-4 w-4 text-muted-foreground\" />\n                              <p className=\"text-sm font-medium\">D├®tail des frais de livraison</p>\n                            </div>\n                            {deliveryFeeBreakdown.baseFee > 0 && (\n                              <div className=\"flex justify-between text-sm\">\n                                <span className=\"text-muted-foreground\">Frais de base ({Object.keys(pharmacyGroups).length} pharmacie(s))</span>\n                                <span>{deliveryFeeBreakdown.baseFee.toLocaleString('fr-FR')} FCFA</span>\n                              </div>\n                            )}\n                            {deliveryFeeBreakdown.distanceFee > 0 && (\n                              <div className=\"flex justify-between text-sm\">\n                                <span className=\"text-muted-foreground\">Frais de distance</span>\n                                <span>{deliveryFeeBreakdown.distanceFee.toLocaleString('fr-FR')} FCFA</span>\n                              </div>\n                            )}\n                            {deliveryFeeBreakdown.urgencyFee > 0 && (\n                              <div className=\"flex justify-between text-sm\">\n                                <span className=\"text-muted-foreground\">Frais d'urgence</span>\n                                <span>{deliveryFeeBreakdown.urgencyFee.toLocaleString('fr-FR')} FCFA</span>\n                              </div>\n                            )}\n                            {deliveryFeeBreakdown.nightFee > 0 && (\n                              <div className=\"flex justify-between text-sm\">\n                                <span className=\"text-muted-foreground\">Frais de nuit (21h-6h)</span>\n                                <span>{deliveryFeeBreakdown.nightFee.toLocaleString('fr-FR')} FCFA</span>\n                              </div>\n                            )}\n                            {deliveryFeeBreakdown.weatherFee > 0 && (\n                              <div className=\"flex justify-between text-sm\">\n                                <span className=\"text-muted-foreground\">Suppl├®ment m├®t├®o</span>\n                                <span>{deliveryFeeBreakdown.weatherFee.toLocaleString('fr-FR')} FCFA</span>\n                              </div>\n                            )}\n                            <div className=\"flex justify-between text-sm font-medium pt-2 border-t\">\n                              <span>Temps estim├®</span>\n                              <span className=\"text-green-600\">{deliveryFeeBreakdown.estimatedTime}</span>\n                            </div>\n                          </CardContent>\n                        </Card>\n                      )}\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardHeader>\n                      <CardTitle className=\"flex items-center gap-2\">\n                        <Receipt className=\"h-5 w-5\" />\n                        Informations suppl├®mentaires\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent className=\"space-y-4\">\n                      <div>\n                        <Label htmlFor=\"notes\">Instructions sp├®ciales (optionnel)</Label>\n                        <Input\n                          id=\"notes\"\n                          placeholder=\"├ëtage, appartement, instructions pour le livreur...\"\n                          value={orderNotes}\n                          onChange={(e) => setOrderNotes(e.target.value)}\n                        />\n                      </div>\n\n                      <div className=\"bg-accent/10 rounded-lg p-4 border border-accent/20\">\n                        <div className=\"flex items-center gap-2 mb-2\">\n                          <Truck className=\"h-4 w-4 text-accent\" />\n                          <span className=\"font-medium\">Informations de livraison</span>\n                        </div>\n                        <ul className=\"text-sm space-y-1\">\n                          <li>ÔÇó Livraison estim├®e: 30-45 minutes</li>\n                          <li>ÔÇó Frais de livraison: {deliveryFee.toLocaleString()} FCFA</li>\n                          <li>ÔÇó Livraison par pharmacie partenaire</li>\n                        </ul>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </TabsContent>\n\n                <TabsContent value=\"payment\" className=\"space-y-6\">\n                  <Card>\n                    <CardHeader>\n                      <CardTitle className=\"flex items-center gap-2\">\n                        <CreditCard className=\"h-5 w-5\" />\n                        Mode de paiement\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent>\n                      <RadioGroup value={selectedPaymentMethod} onValueChange={setSelectedPaymentMethod}>\n                        <div className=\"space-y-4\">\n                          {paymentMethods.map(method => (\n                            <div key={method.id} className={`flex items-center space-x-4 p-4 rounded-lg border ${\n                              method.available \n                                ? 'hover:bg-muted/50 cursor-pointer' \n                                : 'opacity-50 cursor-not-allowed bg-muted/20'\n                            } ${selectedPaymentMethod === method.id ? 'bg-primary/5 border-primary' : ''}`}>\n                              <RadioGroupItem \n                                value={method.id} \n                                id={method.id}\n                                disabled={!method.available}\n                              />\n                              <Label htmlFor={method.id} className=\"flex-1 cursor-pointer\">\n                                <div className=\"flex items-center gap-3\">\n                                  <span className=\"text-2xl\">{method.icon}</span>\n                                  <div>\n                                    <div className=\"font-medium flex items-center gap-2\">\n                                      {method.name}\n                                      {!method.available && (\n                                        <Badge variant=\"outline\" className=\"text-xs\">\n                                          Bient├┤t disponible\n                                        </Badge>\n                                      )}\n                                    </div>\n                                    <div className=\"text-sm text-muted-foreground\">\n                                      {method.description}\n                                    </div>\n                                    <div className=\"text-xs text-secondary\">\n                                      Traitement: {method.processingTime}\n                                    </div>\n                                  </div>\n                                </div>\n                              </Label>\n                            </div>\n                          ))}\n                        </div>\n                      </RadioGroup>\n\n                      {selectedPaymentMethod && selectedPaymentMethod !== 'cash_on_delivery' && (\n                        <div className=\"mt-6\">\n                          <Label htmlFor=\"phone\">Num├®ro de t├®l├®phone</Label>\n                          <Input\n                            id=\"phone\"\n                            type=\"tel\"\n                            placeholder=\"Ex: +225 07 12 34 56 78\"\n                            value={phoneNumber}\n                            onChange={(e) => setPhoneNumber(e.target.value)}\n                          />\n                          <p className=\"text-xs text-muted-foreground mt-1\">\n                            Num├®ro associ├® ├á votre compte {getPaymentMethodById(selectedPaymentMethod)?.name}\n                          </p>\n                        </div>\n                      )}\n\n                      <div className=\"mt-6 bg-green-50 rounded-lg p-4 border border-green-200\">\n                        <div className=\"flex items-center gap-2 mb-2\">\n                          <Shield className=\"h-4 w-4 text-green-600\" />\n                          <span className=\"font-medium text-green-800\">Paiement s├®curis├®</span>\n                        </div>\n                        <p className=\"text-sm text-green-700\">\n                          Toutes les transactions sont chiffr├®es et s├®curis├®es. \n                          Vos donn├®es ne sont jamais stock├®es.\n                        </p>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </TabsContent>\n              </Tabs>\n\n              <Button \n                size=\"lg\" \n                className=\"w-full text-lg py-6\"\n                onClick={handlePayment}\n                disabled={!deliveryAddress || (selectedPaymentMethod !== 'cash_on_delivery' && !phoneNumber)}\n              >\n                <CreditCard className=\"h-5 w-5 mr-2\" />\n                Confirmer le paiement ÔÇó {finalTotal.toLocaleString()} FCFA\n              </Button>\n            </div>\n\n            {/* Right Column - Order Summary */}\n            <div className=\"space-y-6\">\n              <Card>\n                <CardHeader>\n                  <CardTitle className=\"flex items-center gap-2\">\n                    <ShoppingCart className=\"h-5 w-5\" />\n                    R├®sum├® de la commande\n                  </CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-4\">\n                    {Object.entries(pharmacyGroups).map(([pharmacyId, pharmacyItems]) => (\n                      <div key={pharmacyId} className=\"border-b pb-4\">\n                        <h4 className=\"font-medium mb-2\">{pharmacyItems[0].pharmacy_name}</h4>\n                        {pharmacyItems.map(item => (\n                          <div key={item.medicine.id} className=\"flex justify-between text-sm\">\n                            <span>{item.medicine.name} ├ù {item.quantity}</span>\n                            <span>{(item.price * item.quantity).toLocaleString()} FCFA</span>\n                          </div>\n                        ))}\n                      </div>\n                    ))}\n                    \n                    <div className=\"space-y-2 pt-4\">\n                      <div className=\"flex justify-between\">\n                        <span>Sous-total</span>\n                        <span>{totalAmount.toLocaleString()} FCFA</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span>Frais de livraison</span>\n                        <span>{deliveryFee.toLocaleString()} FCFA</span>\n                      </div>\n                      <div className=\"flex justify-between font-bold text-lg border-t pt-2\">\n                        <span>Total</span>\n                        <span>{finalTotal.toLocaleString()} FCFA</span>\n                      </div>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                    <Clock className=\"h-4 w-4\" />\n                    <span>Livraison estim├®e: 30-45 minutes</span>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        )}\n\n        {paymentStep === 'payment' && (\n          <div className=\"max-w-md mx-auto\">\n            <Card>\n              <CardContent className=\"py-12 text-center\">\n                <div className=\"animate-spin h-12 w-12 border-4 border-primary border-t-transparent rounded-full mx-auto mb-4\"></div>\n                <h3 className=\"text-xl font-semibold mb-2\">Traitement du paiement</h3>\n                <p className=\"text-muted-foreground mb-4\">\n                  Veuillez patienter pendant que nous traitons votre paiement...\n                </p>\n                <div className=\"bg-muted rounded-lg p-4\">\n                  <p className=\"text-sm\">\n                    Montant: <span className=\"font-bold\">{finalTotal.toLocaleString()} FCFA</span>\n                  </p>\n                  <p className=\"text-sm\">\n                    Mode: {getPaymentMethodById(selectedPaymentMethod)?.name}\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        )}\n\n        {paymentStep === 'confirmation' && (\n          <div className=\"max-w-2xl mx-auto space-y-6\">\n            <Card>\n              <CardContent className=\"py-12 text-center\">\n                <CheckCircle className=\"h-16 w-16 text-green-500 mx-auto mb-4\" />\n                <h3 className=\"text-2xl font-bold mb-2\">Paiement confirm├® !</h3>\n                <p className=\"text-muted-foreground mb-6\">\n                  Votre commande a ├®t├® enregistr├®e avec succ├¿s\n                </p>\n                \n                <div className=\"bg-green-50 rounded-lg p-4 border border-green-200 mb-6\">\n                  <div className=\"flex items-center justify-center gap-2 mb-2\">\n                    <Receipt className=\"h-5 w-5 text-green-600\" />\n                    <span className=\"font-semibold text-green-800\">Num├®ro de commande</span>\n                  </div>\n                  <div className=\"text-2xl font-bold text-green-800\">{orderId}</div>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\">\n                  <div className=\"bg-muted rounded-lg p-4\">\n                    <Wallet className=\"h-6 w-6 mx-auto mb-2 text-primary\" />\n                    <div className=\"font-semibold\">Montant pay├®</div>\n                    <div className=\"text-lg font-bold text-primary\">\n                      {finalTotal.toLocaleString()} FCFA\n                    </div>\n                  </div>\n                  <div className=\"bg-muted rounded-lg p-4\">\n                    <Clock className=\"h-6 w-6 mx-auto mb-2 text-secondary\" />\n                    <div className=\"font-semibold\">Livraison estim├®e</div>\n                    <div className=\"text-lg font-bold text-secondary\">30-45 min</div>\n                  </div>\n                </div>\n\n                <div className=\"flex flex-col sm:flex-row gap-4\">\n                  <Button variant=\"outline\" className=\"flex-1\" onClick={onBackToHome}>\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Retour ├á l'accueil\n                  </Button>\n                  <Button className=\"flex-1\">\n                    <Truck className=\"h-4 w-4 mr-2\" />\n                    Suivre ma commande\n                  </Button>\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Que se passe-t-il maintenant ?</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-4\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white font-semibold text-sm\">1</div>\n                    <div>\n                      <div className=\"font-medium\">Pr├®paration de votre commande</div>\n                      <div className=\"text-sm text-muted-foreground\">La pharmacie pr├®pare vos m├®dicaments</div>\n       