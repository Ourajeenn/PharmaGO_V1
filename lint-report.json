eState<ReturnType<typeof getPatientAlerts>>([]);\r\n\r\n    useEffect(() => {\r\n        if (currentPatient) {\r\n            const patientSummary = getPatientSummary(currentPatient.id);\r\n            setSummary(patientSummary);\r\n\r\n            const patientAlerts = getPatientAlerts(currentPatient.id);\r\n            setAlerts(patientAlerts);\r\n        }\r\n    }, [currentPatient, getPatientSummary, getPatientAlerts]);\r\n\r\n    // Auto-select first patient if none selected\r\n    useEffect(() => {\r\n        if (!currentPatient && patients.length > 0) {\r\n            setCurrentPatient(patients[0]);\r\n        }\r\n    }, [currentPatient, patients, setCurrentPatient]);\r\n\r\n    const calculateAge = (birthDate: string) => {\r\n        const birth = new Date(birthDate);\r\n        const today = new Date();\r\n        const years = today.getFullYear() - birth.getFullYear();\r\n        const months = today.getMonth() - birth.getMonth();\r\n\r\n        if (years === 0) {\r\n            return `${months} mois`;\r\n        } else if (years < 2) {\r\n            return `${years} an ${months} mois`;\r\n        }\r\n        return `${years} ans`;\r\n    };\r\n\r\n    const getPriorityColor = (priority: string) => {\r\n        switch (priority) {\r\n            case 'Urgente': return 'destructive';\r\n            case 'Haute': return 'default';\r\n            case 'Moyenne': return 'secondary';\r\n            default: return 'outline';\r\n        }\r\n    };\r\n\r\n    return (\r\n        <div className=\"min-h-screen bg-background\">\r\n            <Header />\r\n\r\n            <main className=\"py-16\">\r\n                <div className=\"container mx-auto px-4\">\r\n                    {/* Header */}\r\n                    <div className=\"text-center mb-8\">\r\n                        <h1 className=\"text-4xl font-bold mb-4\">Carnet de sant├® ├®lectronique</h1>\r\n                        <p className=\"text-xl text-muted-foreground max-w-2xl mx-auto\">\r\n                            Votre dossier m├®dical, clair, complet et accessible en un clic.\r\n                        </p>\r\n                    </div>\r\n\r\n                    {/* No Patient State */}\r\n                    {!currentPatient && patients.length === 0 && (\r\n                        <Card className=\"max-w-2xl mx-auto\">\r\n                            <CardContent className=\"p-12 text-center\">\r\n                                <FileHeart className=\"h-16 w-16 mx-auto mb-4 text-muted-foreground\" />\r\n                                <h3 className=\"text-2xl font-semibold mb-2\">Aucun patient enregistr├®</h3>\r\n                                <p className=\"text-muted-foreground mb-6\">\r\n                                    Cr├®ez votre premier carnet de sant├® pour commencer\r\n                                </p>\r\n                                <Button size=\"lg\" onClick={() => navigate('/ecarnet/new-patient')}>\r\n                                    <Plus className=\"h-5 w-5 mr-2\" />\r\n                                    Cr├®er un carnet\r\n                                </Button>\r\n                            </CardContent>\r\n                        </Card>\r\n                    )}\r\n\r\n                    {/* Patient Selected */}\r\n                    {currentPatient && summary && (\r\n                        <div className=\"space-y-6\">\r\n                            {/* Patient Info Card */}\r\n                            <Card>\r\n                                <CardContent className=\"p-6\">\r\n                                    <div className=\"flex items-start gap-6\">\r\n                                        {currentPatient.photo ? (\r\n                                            <img\r\n                                                src={currentPatient.photo}\r\n                                                alt={`${currentPatient.firstName} ${currentPatient.lastName}`}\r\n                                                className=\"w-24 h-24 rounded-full object-cover\"\r\n                                            />\r\n                                        ) : (\r\n                                            <div className=\"w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center\">\r\n                                                <User className=\"h-12 w-12 text-primary\" />\r\n                                            </div>\r\n                                        )}\r\n\r\n                                        <div className=\"flex-1\">\r\n                                            <div className=\"flex items-start justify-between\">\r\n                                                <div>\r\n                                                    <h2 className=\"text-2xl font-bold\">\r\n                                                        {currentPatient.firstName} {currentPatient.lastName}\r\n                                                    </h2>\r\n                                                    <p className=\"text-muted-foreground\">\r\n                                                        {calculateAge(currentPatient.dateOfBirth)} ÔÇó\r\n                                                        {currentPatient.gender === 'M' ? ' Masculin' : ' F├®minin'} ÔÇó\r\n                                                        Groupe {currentPatient.bloodGroup}\r\n                                                    </p>\r\n                                                </div>\r\n\r\n                                                <Button variant=\"outline\" onClick={() => navigate('/ecarnet/profile')}>\r\n                                                    Modifier le profil\r\n                                                </Button>\r\n                                            </div>\r\n\r\n                                            {currentPatient.emergencyContacts.length > 0 && (\r\n                                                <div className=\"mt-4 p-3 bg-muted rounded-lg\">\r\n                                                    <p className=\"text-sm font-medium\">Contact d'urgence:</p>\r\n                                                    <p className=\"text-sm\">\r\n                                                        {currentPatient.emergencyContacts[0].name} - {currentPatient.emergencyContacts[0].phone}\r\n                                                    </p>\r\n                                                </div>\r\n                                            )}\r\n                                        </div>\r\n                                    </div>\r\n                                </CardContent>\r\n                            </Card>\r\n\r\n                            {/* Alerts */}\r\n                            {alerts.length > 0 && (\r\n                                <div className=\"space-y-2\">\r\n                                    <h3 className=\"text-lg font-semibold flex items-center gap-2\">\r\n                                        <Bell className=\"h-5 w-5\" />\r\n                                        Alertes sant├® ({alerts.length})\r\n                                    </h3>\r\n                                    {alerts.slice(0, 3).map(alert => (\r\n                                        <Alert key={alert.id} variant={alert.priority === 'Urgente' ? 'destructive' : 'default'}>\r\n                                            <AlertCircle className=\"h-4 w-4\" />\r\n                                            <AlertDescription>\r\n                                                <div className=\"flex items-center justify-between\">\r\n                                                    <div>\r\n                                                        <span className=\"font-medium\">{alert.title}:</span> {alert.message}\r\n                                                    </div>\r\n                                                    <Badge variant={getPriorityColor(alert.priority) as any}>\r\n                                                        {alert.priority}\r\n                                                    </Badge>\r\n                                                </div>\r\n                                            </AlertDescription>\r\n                                        </Alert>\r\n                                    ))}\r\n                                    {alerts.length > 3 && (\r\n                                        <Button variant=\"link\" onClick={() => navigate('/ecarnet/alerts')}>\r\n                                            Voir toutes les alertes ({alerts.length})\r\n                                        </Button>\r\n                                    )}\r\n                                </div>\r\n                            )}\r\n\r\n                            {/* Quick Stats */}\r\n                            <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\r\n                                <Card>\r\n                                    <CardContent className=\"p-6\">\r\n                                        <div className=\"flex items-center gap-4\">\r\n                                            <div className=\"p-3 bg-blue-100 rounded-lg\">\r\n                                                <Calendar className=\"h-6 w-6 text-blue-600\" />\r\n                                            </div>\r\n                                            <div>\r\n                                                <p className=\"text-sm text-muted-foreground\">Visites</p>\r\n                                                <p className=\"text-2xl font-bold\">{summary.totalVisits}</p>\r\n                                            </div>\r\n                                        </div>\r\n                                    </CardContent>\r\n                                </Card>\r\n\r\n                                <Card>\r\n                                    <CardContent className=\"p-6\">\r\n                                        <div className=\"flex items-center gap-4\">\r\n                                            <div className=\"p-3 bg-green-100 rounded-lg\">\r\n                                                <Syringe className=\"h-6 w-6 text-green-600\" />\r\n                                            </div>\r\n                                            <div>\r\n                                                <p className=\"text-sm text-muted-foreground\">Vaccins</p>\r\n                                                <p className=\"text-2xl font-bold\">{summary.totalVaccinations}</p>\r\n                                                <Badge variant={summary.vaccinationStatus === '├Ç jour' ? 'default' : 'destructive'} className=\"mt-1\">\r\n                                                    {summary.vaccinationStatus}\r\n                                                </Badge>\r\n                                            </div>\r\n                                        </div>\r\n                                    </CardContent>\r\n                                </Card>\r\n\r\n                                <Card>\r\n                                    <CardContent className=\"p-6\">\r\n                                        <div className=\"flex items-center gap-4\">\r\n                                            <div className=\"p-3 bg-purple-100 rounded-lg\">\r\n                                                <FileText className=\"h-6 w-6 text-purple-600\" />\r\n                                            </div>\r\n                                            <div>\r\n                                                <p className=\"text-sm text-muted-foreground\">Documents</p>\r\n                                                <p className=\"text-2xl font-bold\">{summary.totalDocuments}</p>\r\n                                            </div>\r\n                                        </div>\r\n                                    </CardContent>\r\n                                </Card>\r\n\r\n                                <Card>\r\n                                    <CardContent className=\"p-6\">\r\n                                        <div className=\"flex items-center gap-4\">\r\n                                            <div className=\"p-3 bg-orange-100 rounded-lg\">\r\n                                                <AlertCircle className=\"h-6 w-6 text-orange-600\" />\r\n                                            </div>\r\n                                            <div>\r\n                                                <p className=\"text-sm text-muted-foreground\">Allergies</p>\r\n                                                <p className=\"text-2xl font-bold\">{summary.totalAllergies}</p>\r\n                                            </div>\r\n                                        </div>\r\n                                    </CardContent>\r\n                                </Card>\r\n                            </div>\r\n\r\n                            {/* Quick Access */}\r\n                            <div>\r\n                                <h3 className=\"text-lg font-semibold mb-4\">Acc├¿s rapide</h3>\r\n                                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/vaccinations')}\r\n                                    >\r\n                                        <Syringe className=\"h-8 w-8\" />\r\n                                        <span>Vaccinations</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/growth')}\r\n                                    >\r\n                                        <TrendingUp className=\"h-8 w-8\" />\r\n                                        <span>Croissance</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/allergies')}\r\n                                    >\r\n                                        <AlertCircle className=\"h-8 w-8\" />\r\n                                        <span>Allergies</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/visits')}\r\n                                    >\r\n                                        <Activity className=\"h-8 w-8\" />\r\n                                        <span>Visites</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/documents')}\r\n                                    >\r\n                                        <FileText className=\"h-8 w-8\" />\r\n                                        <span>Documents</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/birth')}\r\n                                    >\r\n                                        <FileHeart className=\"h-8 w-8\" />\r\n                                        <span>Naissance</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/family-history')}\r\n                                    >\r\n                                        <User className=\"h-8 w-8\" />\r\n                                        <span>Ant├®c├®dents</span>\r\n                                    </Button>\r\n\r\n                                    <Button\r\n                                        variant=\"outline\"\r\n                                        className=\"h-auto py-6 flex-col gap-2\"\r\n                                        onClick={() => navigate('/ecarnet/export')}\r\n                                    >\r\n                                        <FileText className=\"h-8 w-8\" />\r\n                                        <span>Exporter</span>\r\n                                    </Button>\r\n                                </div>\r\n                            </div>\r\n\r\n                            {/* Recent Activity */}\r\n                            {summary.lastVisit && (\r\n                                <Card>\r\n                                    <CardHeader>\r\n                                        <CardTitle>Derni├¿re visite m├®dicale</CardTitle>\r\n                                    </CardHeader>\r\n                                    <CardContent>\r\n                                        <div className=\"space-y-2\">\r\n                                            <p className=\"text-sm text-muted-foreground\">\r\n                                                {format(new Date(summary.lastVisit.visitDate), 'dd MMMM yyyy', { locale: fr })}\r\n                                            </p>\r\n                                            <p><span className=\"font-medium\">Motif:</span> {summary.lastVisit.reason}</p>\r\n                                            <p><span className=\"font-medium\">M├®decin:</span> {summary.lastVisit.doctorName}</p>\r\n                                            {summary.lastVisit.diagnosis && (\r\n                                                <p><span className=\"font-medium\">Diagnostic:</span> {summary.lastVisit.diagnosis}</p>\r\n                                            )}\r\n                                        </div>\r\n                                    </CardContent>\r\n                                </Card>\r\n                            )}\r\n                        </div>\r\n                    )}\r\n                </div>\r\n            </main>\r\n\r\n            <Footer />\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ECarnetDashboard;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\Index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\Login.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\MedicinesPage.tsx","messages":[],"s