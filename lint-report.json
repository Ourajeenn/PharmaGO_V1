rdDescription>\n        </CardHeader>\n        <CardContent>\n          <Button onClick={onBack} variant=\"outline\" className=\"w-full\">\n            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n            Retour ├á la connexion\n          </Button>\n        </CardContent>\n      </Card>\n    );\n  }\n\n  return (\n    <Card className=\"w-full max-w-md\">\n      <CardHeader>\n        <CardTitle>Mot de passe oubli├®</CardTitle>\n        <CardDescription>\n          Entrez votre email pour recevoir un lien de r├®initialisation\n        </CardDescription>\n      </CardHeader>\n      <CardContent>\n        <form onSubmit={handleResetPassword} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"email\">Email</Label>\n            <Input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"votre@email.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              required\n            />\n          </div>\n\n          <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n            {loading ? 'Envoi en cours...' : 'Envoyer le lien'}\n          </Button>\n\n          <Button\n            type=\"button\"\n            onClick={onBack}\n            variant=\"ghost\"\n            className=\"w-full\"\n          >\n            <ArrowLeft className=\"mr-2 h-4 w-4\" />\n            Retour ├á la connexion\n          </Button>\n        </form>\n      </CardContent>\n    </Card>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\components\\auth\\InsurerAuthForm.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":82,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":82,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3019,3022],"