                  <FormItem>\n                        <FormLabel>Nom complet *</FormLabel>\n                        <FormControl>\n                          <Input placeholder=\"Votre nom complet\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n                  \n                  <FormField\n                    control={signUpForm.control}\n                    name=\"email\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Email *</FormLabel>\n                        <FormControl>\n                          <Input type=\"email\" placeholder=\"votre@email.com\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <FormField\n                      control={signUpForm.control}\n                      name=\"phone\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>T├®l├®phone *</FormLabel>\n                          <FormControl>\n                            <Input placeholder=\"+225 XX XX XX XX\" {...field} />\n                          </FormControl>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n\n                    <FormField\n                      control={signUpForm.control}\n                      name=\"cniNumber\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>N┬░ CNI/Passeport *</FormLabel>\n                          <FormControl>\n                            <Input placeholder=\"CI2024XXXXXXXX\" {...field} />\n                          </FormControl>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <FormField\n                      control={signUpForm.control}\n                      name=\"driverLicense\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>N┬░ Permis de conduire *</FormLabel>\n                          <FormControl>\n                            <Input placeholder=\"A2024XXXXXXX\" {...field} />\n                          </FormControl>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n\n                    <FormField\n                      control={signUpForm.control}\n                      name=\"vehicleType\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>Type v├®hicule *</FormLabel>\n                          <FormControl>\n                            <Input placeholder=\"Moto 125cc, Scooter...\" {...field} />\n                          </FormControl>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n                  </div>\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"experience\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Exp├®rience livraison (optionnel)</FormLabel>\n                        <FormControl>\n                          <Input placeholder=\"Ex: 2 ans chez Glovo, 1 an coursier...\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"password\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Mot de passe *</FormLabel>\n                        <FormControl>\n                          <div className=\"relative\">\n                            <Input\n                              type={showPassword ? 'text' : 'password'}\n                              placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó\"\n                              {...field}\n                            />\n                            <Button\n                              type=\"button\"\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                              onClick={() => setShowPassword(!showPassword)}\n                            >\n                              {showPassword ? (\n                                <EyeOff className=\"h-4 w-4\" />\n                              ) : (\n                                <Eye className=\"h-4 w-4\" />\n                              )}\n                            </Button>\n                          </div>\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"confirmPassword\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Confirmer le mot de passe *</FormLabel>\n                        <FormControl>\n                          <Input\n                            type=\"password\"\n                            placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇ