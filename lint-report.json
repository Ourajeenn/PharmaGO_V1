r />\r\n                <div className=\"flex-1 flex flex-col items-center justify-center p-4\">\r\n                    <h1 className=\"text-2xl font-bold mb-4\">Fonctionnalit├® non trouv├®e</h1>\r\n                    <Button onClick={() => navigate('/consultation')}>Retour</Button>\r\n                </div>\r\n                <Footer />\r\n            </div>\r\n        );\r\n    }\r\n\r\n    const handleAction = () => {\r\n        if (featureId === 'chat') {\r\n            setIsChatOpen(true);\r\n        } else if (featureId === 'ecarnet') {\r\n            // Simulate generating or retrieving an ID\r\n            const carnetId = \"MED-\" + Math.random().toString(36).substr(2, 9).toUpperCase();\r\n            alert(`Votre E-Carnet a ├®t├® cr├®├®/r├®cup├®r├®.\\nID Unique: ${carnetId}\\n\\nConservez cet ID pour permettre aux m├®decins d'acc├®der ├á votre dossier.`);\r\n        } else if (featureId === 'appointment') {\r\n            setIsAppointmentOpen(true);\r\n        } else {\r\n            // Handle other actions or show a toast\r\n            console.log(`Action triggered for ${featureId}`);\r\n        }\r\n    };\r\n\r\n    const Icon = feature.icon;\r\n\r\n    return (\r\n        <div className=\"min-h-screen bg-background flex flex-col\">\r\n            <Header />\r\n\r\n            <main className=\"flex-1 py-12\">\r\n                <div className=\"container mx-auto px-4\">\r\n                    <Button\r\n                        variant=\"ghost\"\r\n                        className=\"mb-8\"\r\n                        onClick={() => navigate('/consultation')}\r\n                    >\r\n                        <ArrowLeft className=\"h-4 w-4 mr-2\" />\r\n                        Retour aux consultations\r\n                    </Button>\r\n\r\n                    <div className=\"max-w-4xl mx-auto\">\r\n                        <div className=\"text-center mb-12\">\r\n                            <div className=\"w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6\">\r\n                                <Icon className=\"h-10 w-10 text-primary\" />\r\n                            </div>\r\n                            <h1 className=\"text-4xl font-bold mb-4\">{feature.title}</h1>\r\n                            <p className=\"text-xl text-muted-foreground\">{feature.description}</p>\r\n                        </div>\r\n\r\n                        <div className=\"grid md:grid-cols-2 gap-8 mb-12\">\r\n                            <Card>\r\n                                <CardHeader>\r\n                                    <CardTitle>Avantages</CardTitle>\r\n                                </CardHeader>\r\n                                <CardContent className=\"space-y-4\">\r\n                                    {feature.details.map((detail: string, index: number) => (\r\n                                        <div key={index} className=\"flex items-start gap-3\">\r\n                                            <CheckCircle className=\"h-5 w-5 text-green-500 mt-0.5\" />\r\n                                            <span>{detail}</span>\r\n                                        </div>\r\n                                    ))}\r\n                                </CardContent>\r\n                            </Card>\r\n\r\n                            <Card className=\"bg-gradient-to-br from-primary/5 to-secondary/5 border-primary/20\">\r\n                                <CardHeader>\r\n                                    <CardTitle>Action rapide</CardTitle>\r\n                                </CardHeader>\r\n                                <CardContent className=\"flex flex-col items-center justify-center h-full min-h-[200px] space-y-6\">\r\n                                    <p className=\"text-center text-muted-foreground\">\r\n                                        Profitez de ce service d├¿s maintenant\r\n                                    </p>\r\n                                    <Button size=\"lg\" className=\"w-full sm:w-auto\" onClick={handleAction}>\r\n                                        {feature.action}\r\n                                    </Button>\r\n                                </CardContent>\r\n                            </Card>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </main>\r\n\r\n            <Footer />\r\n\r\n            <MedicalChatDialog\r\n                isOpen={isChatOpen}\r\n                onClose={() => setIsChatOpen(false)}\r\n            />\r\n\r\n            <AppointmentBookingDialog\r\n                isOpen={isAppointmentOpen}\r\n                onClose={() => setIsAppointmentOpen(false)}\r\n            />\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ConsultationFeaturePage;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\ConsultationPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\ContactPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\Dashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\pages\\DoctorProfilePage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"fi