oit contenir au moins 6 caract├¿res')\n})\n\nconst signUpSchema = z.object({\n  companyName: z.string().min(2, 'Le nom de la compagnie est requis'),\n  representativeName: z.string().min(2, 'Le nom du repr├®sentant est requis'),\n  email: z.string().email('Email invalide'),\n  password: z.string().min(6, 'Le mot de passe doit contenir au moins 6 caract├¿res'),\n  confirmPassword: z.string(),\n  phone: z.string().min(8, 'Num├®ro de t├®l├®phone requis'),\n  licenseNumber: z.string().min(5, 'Num├®ro de licence requis'),\n  registrationNumber: z.string().min(5, 'Num├®ro d\\'enregistrement requis'),\n  insuranceType: z.string().min(2, 'Type d\\'assurance requis'),\n  address: z.string().min(10, 'Adresse compl├¿te requise')\n}).refine((data) => data.password === data.confirmPassword, {\n  message: 'Les mots de passe ne correspondent pas',\n  path: ['confirmPassword']\n})\n\ninterface InsurerAuthFormProps {\n  onSuccess?: () => void\n}\n\nexport const InsurerAuthForm = ({ onSuccess }: InsurerAuthFormProps) => {\n  const [isSignUp, setIsSignUp] = useState(false)\n  const [showPassword, setShowPassword] = useState(false)\n  const [loading, setLoading] = useState(false)\n  const { signIn, signUp } = useAuth()\n  const { toast } = useToast()\n\n  const signInForm = useForm<z.infer<typeof signInSchema>>({\n    resolver: zodResolver(signInSchema),\n    defaultValues: {\n      email: '',\n      password: ''\n    }\n  })\n\n  const signUpForm = useForm<z.infer<typeof signUpSchema>>({\n    resolver: zodResolver(signUpSchema),\n    defaultValues: {\n      companyName: '',\n      representativeName: '',\n      email: '',\n      password: '',\n      confirmPassword: '',\n      phone: '',\n      licenseNumber: '',\n      registrationNumber: '',\n      insuranceType: '',\n      address: ''\n    }\n  })\n\n  const onSignIn = async (values: z.infer<typeof signInSchema>) => {\n    setLoading(true)\n    try {\n      const { error } = await signIn(values.email, values.password)\n      if (error) throw error\n      \n      toast({\n        title: 'Connexion r├®ussie',\n        description: 'Bienvenue dans votre espace assureur!'\n      })\n      onSuccess?.()\n    } catch (error: any) {\n      toast({\n        title: 'Erreur de connexion',\n        description: error.message,\n        variant: 'destructive'\n      })\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  const onSignUp = async (values: z.infer<typeof signUpSchema>) => {\n    setLoading(true)\n    try {\n      const userData = {\n        name: values.companyName.trim(),\n        role: 'insurer',\n        phone: values.phone.trim(),\n        license_number: values.licenseNumber.trim(),\n        company_name: values.companyName.trim()\n      }\n\n      const { error } = await signUp(values.email.trim(), values.password, userData)\n      \n      if (error) {\n        console.error('Insurer signup error:', error)\n        \n        if (error.message.includes('already registered')) {\n          throw new Error('Cet email est d├®j├á utilis├®. Veuillez vous connecter.')\n        }\n        \n        throw new Error(error.message || 'Erreur lors de la cr├®ation du compte')\n      }\n      \n      toast({\n        title: 'Ô£à Demande envoy├®e',\n        description: 'Votre dossier d\\'accr├®ditation sera examin├® sous 72h.'\n      })\n      \n      signUpForm.reset()\n      setIsSignUp(false)\n    } catch (error: any) {\n      console.error('Insurer registration error:', error)\n      toast({\n        title: 'ÔØî Erreur d\\'inscription',\n        description: error.message || 'Une erreur est survenue',\n        variant: 'destructive'\n      })\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-purple-50 via-background to-indigo-50 flex items-center justify-center p-4\">\n      <div className=\"w-full max-w-6xl\">\n        <Button \n          variant=\"outline\" \n          onClick={() => window.history.back()} \n      