\n                      )}\n                    />\n\n                    <FormField\n                      control={signUpForm.control}\n                      name=\"medicalLicense\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>N┬░ Ordre des M├®decins *</FormLabel>\n                          <FormControl>\n                            <Input placeholder=\"OM2024XXXX\" {...field} />\n                          </FormControl>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n                  </div>\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"specialty\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Sp├®cialit├® *</FormLabel>\n                        <Select onValueChange={field.onChange} defaultValue={field.value}>\n                          <FormControl>\n                            <SelectTrigger>\n                              <SelectValue placeholder=\"S├®lectionnez votre sp├®cialit├®\" />\n                            </SelectTrigger>\n                          </FormControl>\n                          <SelectContent>\n                            <SelectItem value=\"generaliste\">M├®decine G├®n├®rale</SelectItem>\n                            <SelectItem value=\"cardiologie\">Cardiologie</SelectItem>\n                            <SelectItem value=\"pediatrie\">P├®diatrie</SelectItem>\n                            <SelectItem value=\"gynecologie\">Gyn├®cologie</SelectItem>\n                            <SelectItem value=\"dermatologie\">Dermatologie</SelectItem>\n                            <SelectItem value=\"psychiatrie\">Psychiatrie</SelectItem>\n                            <SelectItem value=\"autre\">Autre sp├®cialit├®</SelectItem>\n                          </SelectContent>\n                        </Select>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"hospital\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>├ëtablissement (optionnel)</FormLabel>\n                        <FormControl>\n                          <Input placeholder=\"CHU Treichville, Clinique Pasteur...\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"experience\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Ann├®es d'exp├®rience (optionnel)</FormLabel>\n                        <FormControl>\n                          <Input placeholder=\"Ex: 10 ans\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"password\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Mot de passe *</FormLabel>\n                        <FormControl>\n                          <div className=\"relative\">\n                            <Input\n                              type={showPassword ? 'text' : 'password'}\n                              placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó\"\n                              {...field}\n                            />\n                            <Button\n                              type=\"button\"\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                              onClick={() => setShowPassword(!showPassword)}\n                            >\n                              {showPassword ? (\n                                <EyeOff className=\"h-4 w-4\" />\n                              ) : (\n                                <Eye className=\"h-4 w-4\" />\n                              )}\n                            </Button>\n                          </div>\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signUpForm.control}\n                    name=\"confirmPassword\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Confirmer le mot de passe *</FormLabel>\n                        <FormControl>\n                          <Input\n                            type=\"password\"\n                            placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó\"\n                            {...field}\n                          />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n                    {loading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                    Soumettre ma candidature\n                  </Button>\n                </form>\n              </Form>\n            ) : (\n              <Form {...signInForm}>\n                <form onSubmit={signInForm.handleSubmit(onSignIn)} className=\"space-y-4\">\n                  <FormField\n                    control={signInForm.control}\n                    name=\"email\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Email</FormLabel>\n                        <FormControl>\n                          <Input type=\"email\" placeholder=\"dr.kouassi@hopital.ci\" {...field} />\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <FormField\n                    control={signInForm.control}\n                    name=\"password\"\n                    render={({ field }) => (\n                      <FormItem>\n                        <FormLabel>Mot de passe</FormLabel>\n                        <FormControl>\n                          <div className=\"relative\">\n                            <Input\n                              type={showPassword ? 'text' : 'password'}\n                              placeholder=\"ÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇóÔÇó\"\n                              {...field}\n                            />\n                            <Button\n                              type=\"button\"\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                              onClick={() => setShowPassword(!showPassword)}\n                            >\n                              {showPassword ? (\n                                <EyeOff className=\"h-4 w-4\" />\n                              ) : (\n                                <Eye className=\"h-4 w-4\" />\n                              )}\n                            </Button>\n                          </div>\n                        </FormControl>\n                        <FormMessage />\n                      </FormItem>\n                    )}\n                  />\n\n                  <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n                    {loading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n                    Acc├®der aux prescriptions\n                  </Button>\n                </form>\n              </Form>\n            )}\n\n            <div className=\"text-center\">\n              <Button\n                variant=\"link\"\n                onClick={() => setIsSignUp(!isSignUp)}\n                className=\"text-sm\"\n              >\n                {isSignUp \n                  ? 'D├®j├á inscrit ? Se connecter' \n                  : 'Nouveau praticien ? S\\'inscrire'\n                }\n              </Button>\n            </div>\n          </CardContent>\n        </Card>\n        </div>\n      </div>\n    </div>\n  )\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jenra\\Downloads\\pharma-go-express-main (1)\\pharma-go-express-main\\src\\components\\auth\\DriverAuthForm.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":79,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":79,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2734,2737],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2734,2737],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":121,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":121,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3965,3968],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is c