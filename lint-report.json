ormData.apgarScore5min}\r\n                            onChange={(e) => setFormData(prev => ({ ...prev, apgarScore5min: e.target.value }))}\r\n                        />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            {/* Delivery Info */}\r\n            <div className=\"space-y-4\">\r\n                <h3 className=\"font-semibold text-lg\">Informations d'accouchement</h3>\r\n\r\n                <div className=\"grid grid-cols-2 gap-4\">\r\n                    <div>\r\n                        <Label>├ége gestationnel (semaines)</Label>\r\n                        <Input\r\n                            type=\"number\"\r\n                            value={formData.gestationalAge}\r\n                            onChange={(e) => setFormData(prev => ({ ...prev, gestationalAge: e.target.value }))}\r\n                            placeholder=\"39\"\r\n                        />\r\n                    </div>\r\n                    <div>\r\n                        <Label>Type d'accouchement</Label>\r\n                        <Select\r\n                            value={formData.deliveryType}\r\n                            onValueChange={(value: any) => setFormData(prev => ({ ...prev, deliveryType: value }))}\r\n                        >\r\n                            <SelectTrigger>\r\n                                <SelectValue />\r\n                            </SelectTrigger>\r\n                            <SelectContent>\r\n                                <SelectItem value=\"Voie basse\">Voie basse</SelectItem>\r\n                                <SelectItem value=\"C├®sarienne\">C├®sarienne</SelectItem>\r\n                                <SelectItem value=\"Assist├®e\">Assist├®e</SelectItem>\r\n                            </SelectContent>\r\n                        </Select>\r\n                    </div>\r\n                </div>\r\n\r\n                <div>\r\n                    <Label>Complications</Label>\r\n         